{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-workflow-2.local/schemas/execution-ledger.schema.json",
  "title": "Outline Execution Ledger",
  "description": "Append-only evidence for bounded outline implementation runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "policy",
    "status",
    "outline",
    "created_at",
    "updated_at",
    "artifacts",
    "events"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "policy": {
      "enum": ["interactive", "batch"]
    },
    "status": {
      "enum": ["queued", "running", "complete", "failed", "blocked"]
    },
    "outline": {
      "$ref": "#/$defs/artifact"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "relation"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^(docs/|tests/|[A-Za-z0-9_.-])" },
        "relation": {
          "enum": ["implements", "validates", "continues", "input", "output"]
        },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "stage",
        "phase",
        "unit",
        "status",
        "occurred_at",
        "evidence"
      ],
      "properties": {
        "event_id": { "type": "integer", "minimum": 1 },
        "stage": { "const": "implement-outline" },
        "phase": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["queued", "running", "red", "green", "passed", "failed", "blocked", "skipped"]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "command": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
